rules_version = '2';
// Only phones that joined with the family's secret join code can see or change family data.
// Tested in tests/rules/rules.test.mjs (npm run test:rules).
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function famPath(fid) { return /databases/$(db)/documents/families/$(fid); }
    function isIn(fid) {
      return signedIn() && exists(/databases/$(db)/documents/families/$(fid)/joins/$(request.auth.uid));
    }
    function dataColl(c) { return c in ['members', 'catalog', 'grocery', 'txns', 'bills', 'log', 'media', 'cash', 'loans', 'jars', 'contacts', 'cats']; }

    // Username + password logins (login.js). The record name comes from the password and its
    // content is encrypted, so it can only be read by someone who knows both. No listing.
    // Only members of a family can make or remove logins for that family.
    match /logins/{id} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && id.size() == 40
        && request.resource.data.keys().hasOnly(['iv', 'ct', 'fid', 'ts'])
        && request.resource.data.fid is string && isIn(request.resource.data.fid);
      allow delete: if signedIn() && isIn(resource.data.fid);
    }

    match /families/{fid} {
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.size() >= 20;
      allow read: if isIn(fid);
      allow update: if isIn(fid)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.joinCode == resource.data.joinCode;
      allow delete: if false;

      // A phone joins by proving it knows the join code (from the QR / link).
      match /joins/{uid} {
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['code', 'ts'])
          && request.resource.data.code == get(famPath(fid)).data.joinCode;
        allow read: if isIn(fid);
        allow update, delete: if false;
      }

      match /{coll}/{id} {
        allow read, create: if dataColl(coll) && isIn(fid);
        // History log is append-only so the admin can trust it.
        allow update, delete: if dataColl(coll) && coll != 'log' && isIn(fid);
      }
    }
  }
}
